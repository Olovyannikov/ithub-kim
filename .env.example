# База данных (docker compose поднимает PostgreSQL с этими параметрами)
POSTGRES_USER=kim
POSTGRES_PASSWORD=kim
POSTGRES_DB=conferences
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kim:kim@localhost:5432/conferences

# Бэкенд
API_PORT=3000
WEB_ORIGIN=http://localhost:5173


# Секрет для подписи сессионного токена. Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Выставлять cookie только по HTTPS. На площадке ДЭ приложение работает по http.
COOKIE_SECURE=false

# Ограничение частоты входа и регистрации. Для повторных сквозных прогонов
# можно поднять: AUTH_THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL=60000

# Режим быстрой правки схемы для экзамена: TypeORM приводит базу к сущностям
# при старте, миграции не нужны. В подготовке держим false.
DB_SYNCHRONIZE=false

# Запасной бэкенд на Python (ADR-0011)
MYSQL_ROOT_PASSWORD=kim
MYSQL_DATABASE=conferences
MYSQL_USER=kim
MYSQL_PASSWORD=kim
MYSQL_PORT=3306
MYSQL_URL=mysql+pymysql://kim:kim@localhost:3306/conferences?charset=utf8mb4
PY_API_PORT=3001
