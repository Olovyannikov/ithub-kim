# База данных (docker compose поднимает PostgreSQL с этими параметрами)
POSTGRES_USER=kim
POSTGRES_PASSWORD=kim
POSTGRES_DB=conferences
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kim:kim@localhost:5432/conferences

# Бэкенд
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Секреты аутентификации — конкретные переменные появятся в Части 2 (ADR-0004)
# SESSION_SECRET=
