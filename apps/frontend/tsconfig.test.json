{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Тесты выполняет встроенный раннер Node, поэтому нужен CommonJS:
    // исходники фронтенда рассчитаны на сборщик и не содержат расширений
    // в относительных импортах, а NodeNext в режиме ESM их требует.
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "declaration": false,
    "outDir": "./dist-test",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.tsx"]
}
