  "info": {
    "title": "Конференции.РФ — API",
    "description": "Информационная система бронирования помещений для Всероссийских конференций. КИМ 09.02.07-3-2027, Том 1 (инвариантная часть).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Регистрация, вход, выход, текущий пользователь"
    },
    {
      "name": "rooms",
      "description": "Справочник помещений для выпадающего списка"
    },
    {
      "name": "applications",
      "description": "Заявки пользователя, отзывы и панель администратора"
    },
    {
      "name": "health",
      "description": "Проверка работоспособности"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "conf_session",
        "description": "httpOnly-cookie с подписанным токеном сессии (ADR-0004)"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "login",
          "password",
          "fullName",
          "phone",
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "CreateApplicationDto": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "number",
            "minimum": 1
          },
          "startsAt": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "При очном посещении",
              "Переводом по системе СБП"
            ]
          }
        },
        "required": [
          "roomId",
          "startsAt",
          "paymentMethod"
        ]
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "rating",
          "text"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Мероприятие назначено",
              "Завершено"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
