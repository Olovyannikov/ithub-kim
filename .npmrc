# Версия pnpm закреплена через "packageManager" в package.json (corepack).
# Точные версии в package.json — чтобы установка на площадке ДЭ была воспроизводимой.
save-exact=false
# Офлайн-режим экзамена: см. docs/adr/0002-monorepo-and-package-manager.md.
# Если потребуется переносимый node_modules — раскомментировать:
# node-linker=hoisted
