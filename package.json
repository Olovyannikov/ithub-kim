{
  "name": "ithub-kim",
  "version": "0.0.0",
  "private": true,
  "description": "Конференции.РФ — подготовка к демонстрационному экзамену по КИМ 09.02.07-3-2027",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm run shared:build && concurrently -n shared,back,front -c gray,blue,magenta \"pnpm run shared:dev\" \"pnpm run dev:back\" \"pnpm run dev:front\"",
    "dev:back": "pnpm --filter @kim/backend dev",
    "dev:front": "pnpm --filter @kim/frontend dev",
    "shared:build": "pnpm --filter @kim/shared build",
    "shared:dev": "pnpm --filter @kim/shared dev",
    "build": "pnpm run shared:build && pnpm --filter @kim/backend build && pnpm --filter @kim/frontend build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "node scripts/e2e.mjs",
    "images": "node scripts/optimize-images.mjs",
    "shared:python": "node scripts/generate-python-shared.mjs",
    "py:install": "bash scripts/python-setup.sh",
    "py:dev": "apps/backend-py/.venv/bin/python -m uvicorn app.main:app --app-dir apps/backend-py --port ${PY_API_PORT:-3001} --reload",
    "py:seed": "cd apps/backend-py && .venv/bin/python -m app.seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger apps/frontend/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mantine:docs": "bash scripts/fetch-mantine-docs.sh",
    "mantine:docs:full": "bash scripts/fetch-mantine-docs.sh --full",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d",
    "router:docs": "bash scripts/fetch-router-docs.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-effector": "^0.19.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "steiger": "^0.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
